# Application
BTA_ENVIRONMENT=development
BTA_DEBUG=true
BTA_API_PREFIX=/api/v1
BTA_CORS_ORIGINS=["http://localhost:5173"]

# Storage
BTA_DATA_ROOT=./runtime/data
BTA_MODEL_ROOT=./runtime/models
BTA_FAISS_INDEX_PATH=./runtime/faiss
BTA_MAX_UPLOAD_SIZE_MB=1024

# nnU-Net V2 workspace. The segmentation scripts derive nnUNet_raw,
# nnUNet_preprocessed and nnUNet_results from this root.
NNUNET_ROOT=./runtime/nnunet
BTA_NNUNET_DATASET_ID=137
BTA_NNUNET_CONFIGURATION=3d_fullres
BTA_NNUNET_PLANS=nnUNetResEncUNetMPlans
BTA_NNUNET_TRAINER=nnUNetTrainer
BTA_NNUNET_FOLDS=["0","1","2","3","4"]
BTA_NNUNET_DEVICE=cuda
BTA_NNUNET_GPU_ID=0
BTA_NNUNET_CHECKPOINT=checkpoint_final.pth
BTA_NNUNET_OUTPUT_LABEL_PROFILE=standard_nnunet
BTA_NNUNET_STEP_SIZE=0.5
BTA_NNUNET_PREPROCESSING_PROCESSES=1
BTA_NNUNET_EXPORT_PROCESSES=1
BTA_NNUNET_DISABLE_TTA=false

# Infrastructure
BTA_DATABASE_URL=postgresql+psycopg://brain_tumor:brain_tumor@localhost:5432/brain_tumor
BTA_REDIS_URL=redis://127.0.0.1:6379/0
BTA_CELERY_TASK_ALWAYS_EAGER=false
BTA_ANALYSIS_TASK_MAX_RETRIES=1
BTA_ANALYSIS_TASK_RETRY_DELAY_SECONDS=30

# Qwen / Alibaba Cloud Model Studio
DASHSCOPE_API_KEY=
BTA_QWEN_MODEL=qwen-plus
BTA_QWEN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
BTA_QWEN_TIMEOUT_SECONDS=60
# Workspace-specific endpoints may reject this optional DashScope header.
BTA_QWEN_ENABLE_DATA_INSPECTION=false
BTA_AGENT_TEMPERATURE=0.1
BTA_AGENT_MAX_TOKENS=1000
BTA_REPORT_TEMPERATURE=0.2
BTA_REPORT_MAX_TOKENS=800

# Local medical RAG embedding
BTA_EMBEDDING_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
BTA_EMBEDDING_DEVICE=cpu
BTA_EMBEDDING_BATCH_SIZE=16
BTA_EMBEDDING_CACHE_DIR=./runtime/models/huggingface
BTA_EMBEDDING_LOCAL_FILES_ONLY=false
