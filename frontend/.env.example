# Keep the relative path when Vite and FastAPI share one domain.
VITE_API_BASE_URL=/api/v1
# 开发/预览服务器使用（不带 VITE_ 前缀）：由 Vite 代理在服务端注入 X-API-Key，
# 不会打包进浏览器代码。前后端分开部署时应由反向代理注入同名请求头。
BTA_API_KEY=replace-with-the-same-BTA_API_KEY

# For a separately deployed backend, use for example:
# VITE_API_BASE_URL=https://api.example.com/api/v1
